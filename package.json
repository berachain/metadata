{
  "name": "berachain-metadata",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "biome format --write",
    "validate:images": "tsx scripts/validateImages.ts",
    "validate:json": "tsx scripts/validateJSON.ts",
    "validate:data": "tsx scripts/validateOnChainData/main.ts",
    "validate": "pnpm run validate:json && pnpm run validate:images && pnpm run validate:data",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "keywords": [
    "berachain",
    "metadata",
    "tokens",
    "validators",
    "vaults"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.13.13",
    "ajv": "8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "4.19.3",
    "viem": "^2.24.2"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "jsonc-parser": "^3.3.1"
  }
}
