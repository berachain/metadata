{
  "name": "berachain-metadata",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "biome format --write",
    "validate:images": "tsx scripts/validateImages.ts",
    "upload:assets": "tsx scripts/uploadAssets.ts",
    "validate:json": "tsx scripts/validateJSON.ts",
    "validate:data": "tsx scripts/validateOnChainData/main.ts",
    "validate:pyth": "tsx scripts/validatePythPriceIds.ts",
    "validate:coingecko": "tsx scripts/validateCoingeckoIds.ts",
    "validate": "pnpm run validate:json && pnpm run validate:images && pnpm run validate:data && pnpm run validate:pyth && pnpm run validate:coingecko",
    "metadata:missing": "tsx scripts/manageVaultsFromApi.ts add",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "keywords": [
    "berachain",
    "metadata",
    "tokens",
    "validators",
    "vaults"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "22.13.13",
    "ajv": "8.18.0",
    "ajv-formats": "^3.0.1",
    "cloudinary": "2.10.0",
    "dotenv": "17.4.2",
    "tsx": "4.23.0",
    "viem": "2.53.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@berachain/berajs": "0.3.4",
    "bignumber.js": "11.1.4",
    "chalk": "^5.6.2",
    "cloudinary": "2.10.0",
    "jsonc-parser": "3.3.1",
    "sharp": "0.35.3"
  }
}
